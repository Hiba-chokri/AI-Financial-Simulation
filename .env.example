# Database Configuration
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=daba_dar_db

# Application Configuration
ENVIRONMENT=development
API_V1_STR=/api/v1

# --- API Authentication -------------------------------------------------------
# Comma-separated list of API keys the service will accept.
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DABA_API_KEYS=replace-with-a-strong-key,and-another-if-you-want

# Set to "false" to bypass API-key checks during local development.
DABA_AUTH_ENABLED=true

# --- CORS ---------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API.
# Only needed if a BROWSER on these sites calls the API directly; server-to-server
# calls (recommended) ignore CORS entirely. Leave blank to block all browser access.
DABA_ALLOWED_ORIGINS=https://dabacities.com,https://www.dabacities.com,http://localhost:3000,http://localhost:8501

# --- Hardening ----------------------------------------------------------------
# Maximum accepted request body size in bytes (simulation payloads are tiny).
DABA_MAX_BODY_BYTES=100000

# --- Live exchange rates -------------------------------------------------------
# Free key from https://www.exchangerate-api.com/ — without it, currency
# conversion runs in degraded "bootstrap" mode using fixed fallback rates
# (see app/engine/currency.py). Check GET /api/v1/health -> fx_rates_source.
DABA_EXCHANGE_RATE_API_KEY=

# How often to refresh rates from the live API, in seconds (default 6 hours).
DABA_FX_REFRESH_SECONDS=21600